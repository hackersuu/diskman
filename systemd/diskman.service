[Unit]
Description=diskman — Yapılandırılmış diskleri otomatik bağla
Documentation=https://github.com/user/diskman
# Ağ gerekmez, oturum açıldıktan sonra çalışsın
After=default.target

[Service]
Type=oneshot

# Binary yolu (pacman paketi /usr/bin/diskman altına kurar)
ExecStart=/usr/bin/diskman

# Oturum kapandığında diskman'ı çalıştırma
RemainAfterExit=no

# Hata olursa log'a yaz ama oturumu engelleme
SuccessExitStatus=0 1

# Ortam değişkeni (isteğe bağlı log seviyesi geçersiz kılma)
# Environment=RUST_LOG=debug

[Install]
WantedBy=default.target
